    {
        "id": "6310005",
        "type": "function",
        "z": "tab6310001",
        "name": "analyze vibration, shape for Redpanda",
        "func": "// The Nano has no RTC, t_ms is milliseconds since its own boot, not a\n// wall-clock timestamp, so it cannot be written to the DB or used to key a\n// Kafka message as-is. Node-RED's own arrival time stands in instead.\n//\n// This is also where this lab's two streams are actually built. Every valid\n// sample becomes one message on output 1, published verbatim to Redpanda\n// topic imu.raw, whatever any consumer does with it. A second, independent\n// judgement runs alongside that: a short rolling window (~20 samples, ~170 ms\n// at the LSM9DS1's ~119 Hz) of the acceleration vector's magnitude,\n// |a| = sqrt(ax^2+ay^2+az^2). At rest |a| sits near 1 g (gravity) and barely\n// moves; a real knock or shake makes it swing hard within that window. When\n// the window's peak-to-peak swing crosses ALERT_THRESHOLD_G, output 2 fires\n// once - a per-device cooldown stops one shake from producing a burst of\n// alerts - publishing only to imu.alerts.\n//\n// This is section 6.9's windowed stream processing, running for real, and it\n// is also the reason imu.raw and imu.alerts are two separate Redpanda topics\n// rather than one stream with a severity field: two different consumers\n// (tabs 2 and 3) each want only one of these two judgements, at their own\n// pace, without the other's volume passing through them to get filtered out.\n\nconst ALERT_THRESHOLD_G = 0.5;   // peak-to-peak |a| swing over the window, in g\nconst WINDOW_SAMPLES     = 20;   // ~170 ms at ~119 Hz\nconst COOLDOWN_MS        = 2000; // minimum gap between two alerts for the same device\n\nconst p = msg.payload;\n\nif (p && p.device && typeof p.ax === 'number' && typeof p.ay === 'number' && typeof p.az === 'number') {\n    const ts = new Date().toISOString();\n    const mag = Math.sqrt(p.ax * p.ax + p.ay * p.ay + p.az * p.az);\n\n    const winKey = 'vibWindow_' + p.device;\n    const window = flow.get(winKey) || [];\n    window.push(mag);\n    if (window.length > WINDOW_SAMPLES) window.shift();\n    flow.set(winKey, window);\n\n    const peakToPeak = window.length > 1 ? Math.max(...window) - Math.min(...window) : 0;\n\n    const rawMsg = {\n        key: p.device,\n        payload: { ts, device: p.device, ax: p.ax, ay: p.ay, az: p.az, mag_g: Number(mag.toFixed(4)) }\n    };\n\n    let alertMsg = null;\n    const cooldownKey = 'lastAlertAt_' + p.device;\n    const lastAlertAt = flow.get(cooldownKey) || 0;\n    if (peakToPeak > ALERT_THRESHOLD_G && (Date.now() - lastAlertAt) > COOLDOWN_MS) {\n        flow.set(cooldownKey, Date.now());\n        alertMsg = {\n            key: p.device,\n            payload: {\n                ts, device: p.device,\n                peak_to_peak_g: Number(peakToPeak.toFixed(3)),\n                mag_g: Number(mag.toFixed(3)),\n                threshold_g: ALERT_THRESHOLD_G,\n                ax: p.ax, ay: p.ay, az: p.az\n            }\n        };\n    }\n\n    return [rawMsg, alertMsg, null];\n}\n\n// Boot banner ({\"status\":\"ready\",...}) or an IMU init error, not a sample.\nreturn [null, null, msg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 140,
        "wires": [
            [
                "6320p01"
            ],
            [
                "6320p04"
            ],
            [
                "6310009"
            ]
        ]
    },
