    {
        "id": "6320f01",
        "type": "function",
        "z": "tab6320002",
        "name": "shape for insert",
        "func": "// msg.payload is already the parsed JS object - the kafka-consumer node\n// JSON-decodes it for us. Build the parameterized INSERT's positional\n// args from it. This function, not the producer on tab 1, is what\n// actually writes to TimescaleDB now: the two are decoupled by\n// Redpanda, this consumer can stop, fall behind, or be redeployed\n// without the board or the producer even noticing.\nconst p = msg.payload;\nif (!p || !p.device) return null;\nmsg.params = [p.ts, p.device, p.ax, p.ay, p.az, p.mag_g];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
