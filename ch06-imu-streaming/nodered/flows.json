    {
        "id": "6320f02",
        "type": "function",
        "z": "tab6320003",
        "name": "shape alert for insert + live feed",
        "func": "const p = msg.payload;\nif (!p || !p.device) return [null, null];\n\nconst dbMsg = { params: [p.ts, p.device, p.peak_to_peak_g, p.mag_g, p.threshold_g, p.ax, p.ay, p.az] };\n\n// One row straight onto the Live dashboard's alert table - action\n// 'append' on that ui-table widget adds it without a database round\n// trip. This is the speed-layer half of a Lambda-style split: the\n// same event reaches the screen twice, once here direct from the log,\n// and again later when the History page polls imu_alerts on a timer.\nconst feedMsg = {\n    payload: {\n        ts: p.ts,\n        device: p.device,\n        peak_to_peak_g: p.peak_to_peak_g,\n        mag_g: p.mag_g,\n        threshold_g: p.threshold_g\n    }\n};\n\nreturn [dbMsg, feedMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 100,
        "wires": [
            [
                "6320a01"
            ],
            [
                "6320a02"
            ]
        ]
    },
