        "func": "// One row -> three chart messages (msg.topic = series name), the\n// ui-chart node's default 'append, timestamp x-axis' behaviour handles\n// the rest, one line per axis, timestamped on arrival.\nif (!Array.isArray(msg.payload) || msg.payload.length === 0) {\n    return [null, { payload: 'no samples yet, is the board plugged in and the sketch running?' }];\n}\nconst row = msg.payload[0];\nconst out = ['ax', 'ay', 'az'].map((axis) => ({ topic: axis, payload: row[axis] }));\nconst status = `device ${row.device} \\u00b7 last row ${row.ts}`;\nreturn [out, { payload: status }];",
